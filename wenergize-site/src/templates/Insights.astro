---
import Base from '../layouts/Base.astro';
import { copyFor, pages, type Lang } from '../i18n/utils';
import { site } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copyFor(lang);
const i = t.insights;
---

<Base lang={lang} path={pages.insights} title={t.meta.insights.title} description={t.meta.insights.description}>
  <div class="page-head">
    <div class="container">
      <h1>{i.h1}</h1>
      <p class="lead">{i.intro}</p>
    </div>
  </div>

  <section>
    <div class="container">
      <!-- Stage 3 replaces this empty state with the list of published posts. -->
      <div class="post-list">
        <div class="empty">
          <p>{i.empty}</p>
          {site.linkedin && <a class="btn btn-ghost" href={site.linkedin} rel="noopener">{i.linkedin}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
